NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/autoaudit
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Email configuration
# IMPORTANT: EMAIL_FROM domain must be verified in Resend before emails will deliver.
# See docs/EMAIL_DELIVERABILITY.md for DNS setup instructions.
RESEND_API_KEY=        # Your Resend API key from resend.com/api-keys
EMAIL_FROM=            # Must match your verified Resend domain
                       # Format: AutoAudit.ai <noreply@yourdomain.com>
CONTACT_TO_EMAIL=      # Where contact form submissions are sent
CONTACT_ADMIN_EMAILS=  # Comma-separated admin notification addresses

APP_URL=http://127.0.0.1:5173
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:5000/api/auth/google/callback
VITE_API_URL=http://127.0.0.1:5000
VITE_SITE_URL=http://127.0.0.1:5173
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
